<?xml version="1.0" encoding="utf-8"?>
<!-- Live countdown for the widget. Glance has no chronometer, so this plain RemoteViews layout is embedded.
     Glance stretches the box around it over all the free space between the lines above and below,
     so the frame fills that box and centres the countdown in it, where the ready/paused time sits. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Chronometer
        android:id="@+id/countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/widget_text"
        android:textSize="40sp"
        android:textStyle="bold" />
</FrameLayout>
