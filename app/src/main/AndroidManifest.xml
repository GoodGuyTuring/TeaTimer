<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Countdown notification and "infusion done" alert. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Timer apps may use exact alarms without asking; needed so the alarm fires on time. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- AlertService: ring/vibrate for a few seconds, also with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Only for "Update teas" (downloads the tea list from GitHub). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TeaTimer">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.TeaTimerWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tea_timer_widget_info" />
        </receiver>

        <receiver
            android:name=".brew.AlarmReceiver"
            android:exported="false" />

        <service
            android:name=".brew.AlertService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
    </application>
</manifest>
